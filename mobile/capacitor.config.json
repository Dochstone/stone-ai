{
  "appId": "ru.stoneai.app",
  "appName": "Stone AI",
  "webDir": "www",
  "server": {
    "url": "https://stoneai.ru",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#1a1a1e",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1a1a1e"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#1a1a1e"
  }
}
