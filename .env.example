# Stone AI — Environment Variables
# Copy this file to .env and fill in the values

# --- Required ---

# OpenRouter API key (get it at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/stone_ai

# --- Optional ---

# Vercel deployment URL (used for CORS and OpenRouter referer)
APP_URL=https://stone-ai-1.vercel.app

# CryptoBot API token (Phase 3 — USDT payments)
# CRYPTOBOT_TOKEN=

# TON Connect manifest URL (Phase 2)
# TON_MANIFEST_URL=
